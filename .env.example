# ATEMS environment template: copy to .env and fill in. PLACEHOLDERS ONLY; never commit real values.
# See README.md and docs/PUBLIC_SNAPSHOT.md.

ENVIRONMENT=production
DEBUG=False

SECRET_KEY=change-me

POSTGRES_PASSWORD=change-me
SQLALCHEMY_DATABASE_URI=postgresql://atems_user@127.0.0.1:5436/atems

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=operator@example.com
USER_USERNAME=user
USER_PASSWORD=change-me

APPLICATION_ROOT=
PORT=5000

